# Copy this file to .env.local and fill in real values.
# See README.md for where to get each one.

# Postgres connection string (Neon, Supabase, or any Postgres host)
DATABASE_URL="postgresql://user:password@host:5432/pongolux"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Optional OAuth providers (leave blank to disable)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Sales tax — only set to "true" AFTER Stripe Tax is activated in the
# Dashboard (Settings > Tax: origin address + at least one active
# registration, e.g. Illinois). Turning this on before that setup is done
# will make every checkout fail. See README.md "Sales tax" section.
STRIPE_TAX_ENABLED="false"

# Vercel Blob storage — powers photo uploads in /admin. On Vercel: project
# -> Storage -> Create Database -> Blob, connect it to this project, and
# Vercel adds this automatically. Not needed to run the site locally.
BLOB_READ_WRITE_TOKEN=""

# Resend (transactional email)
RESEND_API_KEY=""
EMAIL_FROM="PongoLux <orders@pongolux.com>"

# Base URL of the deployed site (used for Stripe redirect URLs, emails,
# and page metadata). Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL="https://www.pongolux.com"
